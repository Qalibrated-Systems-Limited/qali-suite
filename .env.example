# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way — never commit real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/stockvault
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>
MONGODB_URI=mongodb://localhost:27017/stockvault

# Set to "false" in production — autoIndex on every boot is slow at volume.
MONGO_AUTOINDEX=true

# ─── PostgreSQL (migration in progress) ──────────────────────────────────────
# Only needed on feat/postgres-migration. See docs/POSTGRES-MIGRATION-PLAN.md.
#
# THE ROLE MATTERS AS MUCH AS THE HOST. Tenant isolation is row-level security,
# and a role with BYPASSRLS — every superuser has it — ignores every policy in
# the schema. Measured: same query, no app.company_id set, one invoice present:
#
#   postgres (superuser)           -> 1 row   policies inert
#   app_user (NOBYPASSRLS)         -> 0 rows  fails closed, as designed
#
# So the APPLICATION connects as app_user (created and granted in migration
# 0023). Never as postgres. `SELECT assert_rls_effective()` raises if the
# current connection would bypass RLS — worth calling from a health check.
#
# ON A FRESH CLUSTER 0023 CREATES THE ROLE BUT CANNOT LET IT IN. It runs
# `CREATE ROLE app_user NOLOGIN` with no password, because inventing a
# credential is not a migration's job. So standing up an empty deployment takes
# one manual step, after migrating and before the app boots:
#
#   ALTER ROLE app_user LOGIN PASSWORD '<pass>';
#
# Skip it and every query fails with "role app_user is not permitted to log in".
#
# Local:  postgresql://app_user:<pass>@localhost:5433/stockvault
# Neon:   postgresql://<user>:<pass>@<host>-pooler.neon.tech/<db>?sslmode=require
#
# Note the local port: the stockvault-pg container publishes 5433, not 5432.
# Leaving this empty makes `npm test` SKIP the Postgres suites silently.
DATABASE_URL=

# Migrations and drizzle-kit only. Leave empty locally — it falls back to
# DATABASE_URL when unset.
#
# In production this must be the DIRECT (unpooled) endpoint and a privileged
# role. The migrator takes an advisory lock and runs DDL in long transactions,
# neither of which survives transaction-mode pooling; and migrations that touch
# tenant data (0017's amount_paid reconciliation) scan across companies with no
# app.company_id set, which under RLS would return zero rows and silently
# reconcile nothing.
#
# Neon:   postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
#         (the hostname WITHOUT "-pooler")
DIRECT_DATABASE_URL=

# Pool size per serverless instance. Keep low behind PgBouncer/Neon pooling.
PGPOOL_MAX=10

# ─── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# Generate your own — do NOT reuse anyone else's:
#   openssl rand -base64 32
AUTH_SECRET=

# Base URL of the app. http://localhost:3000 for local dev.
APP_URL=http://localhost:3000

# Google sign-in. Optional locally — leave blank to use credentials login.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── File uploads (Cloudinary) ───────────────────────────────────────────────
# Optional locally; uploads fail without it. https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
# Either Resend (preferred) or SMTP. Both optional locally.
RESEND_API_KEY=
FROM_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# NOTE: these two are spelled STMP_ (not SMTP_) in the code. Kept as-is so the
# app works; renaming touches lib/ and the mailer.
STMP_FROM_EMAIL=
STMP_FROM_NAME=

# ─── Cron endpoints ──────────────────────────────────────────────────────────
# Shared secret guarding /api/cron/* so they can't be triggered publicly.
#   openssl rand -hex 24
CRON_SECRET=

# ─── Test runner ─────────────────────────────────────────────────────────────
# Set to "1" in CI to skip the mongodb-memory-server binary download.
MONGOMS_DISABLE_POSTINSTALL=
