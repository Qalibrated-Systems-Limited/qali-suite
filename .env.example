# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way — never commit real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/stockvault
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>
MONGODB_URI=mongodb://localhost:27017/stockvault

# Set to "false" in production — autoIndex on every boot is slow at volume.
MONGO_AUTOINDEX=true

# ─── PostgreSQL (migration in progress) ──────────────────────────────────────
# Only needed on feat/postgres-migration. See docs/POSTGRES-MIGRATION-PLAN.md.
# Local:  postgresql://postgres:postgres@localhost:5432/stockvault
# Neon:   postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Pool size per serverless instance. Keep low behind PgBouncer/Neon pooling.
PGPOOL_MAX=10

# ─── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# Generate your own — do NOT reuse anyone else's:
#   openssl rand -base64 32
AUTH_SECRET=

# Base URL of the app. http://localhost:3000 for local dev.
APP_URL=http://localhost:3000

# Google sign-in. Optional locally — leave blank to use credentials login.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── File uploads (Cloudinary) ───────────────────────────────────────────────
# Optional locally; uploads fail without it. https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
# Either Resend (preferred) or SMTP. Both optional locally.
RESEND_API_KEY=
FROM_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# NOTE: these two are spelled STMP_ (not SMTP_) in the code. Kept as-is so the
# app works; renaming touches lib/ and the mailer.
STMP_FROM_EMAIL=
STMP_FROM_NAME=

# ─── Cron endpoints ──────────────────────────────────────────────────────────
# Shared secret guarding /api/cron/* so they can't be triggered publicly.
#   openssl rand -hex 24
CRON_SECRET=

# ─── Test runner ─────────────────────────────────────────────────────────────
# Set to "1" in CI to skip the mongodb-memory-server binary download.
MONGOMS_DISABLE_POSTINSTALL=
