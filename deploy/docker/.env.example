# Copy to deploy/docker/.env and fill in, then: chmod 600 .env
#
# Read by docker-compose.postgres.yml. Both are used ONLY on first start, when
# the volume is empty — changing them later does not change the roles. See
# DEPLOYMENT.md for rotating a password on an existing volume.

# The superuser. Used by migrations and the SuperAdmin platform reads
# (DIRECT_DATABASE_URL). Never by ordinary request traffic.
POSTGRES_SUPERUSER_PASSWORD=

# The role the APPLICATION connects as (DATABASE_URL). A non-superuser, so
# row-level security applies to it — which is what keeps one tenant out of
# another's data.
APP_DB_PASSWORD=

# Generate each with:  openssl rand -hex 24
#
# HEX, not base64. These values go into connection strings —
# postgresql://app_user:PASSWORD@127.0.0.1:5432/qalisuite — and base64 emits
# `+`, `/` and `=`. A `/` or `@` in the password breaks the URL and surfaces as
# an authentication failure that looks like a wrong password rather than a
# malformed URL. Hex has the same entropy per length and needs no escaping.
