# ============================================
# QaliSuite — Production Environment Variables
# Copy to /opt/qalisuite/.env and fill in values
# ============================================

# Auth
AUTH_SECRET=
JWT_KEY=

# Database (MongoDB Atlas recommended for managed DB)
MONGODB_URI=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (email)
RESEND_API_KEY=
FROM_EMAIL=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App URL (IMPORTANT: update to your domain)
APP_URL=https://qalisuite.com
NEXTAUTH_URL=https://qalisuite.com
