# ============================================
# QaliSuite — Production Environment Variables
# Copy to /opt/qalisuite/.env, fill in, then: chmod 600 /opt/qalisuite/.env
# ============================================
#
# THIS FILE IS NOT A SHELL SCRIPT. Do not `source` it — FROM_EMAIL contains
# `<...>`, which a shell reads as a redirect. Next.js loads it with
# --env-file; scripts that need one value should grep it out (see
# deploy/setup-cron.sh).
#
# Do NOT wrap values in quotes unless the value needs them.

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=          # openssl rand -base64 32
JWT_KEY=              # openssl rand -base64 32

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# THE APP CONNECTS AS A NON-SUPERUSER. Tenant isolation is row-level security,
# and a superuser BYPASSES RLS — connecting as `postgres` here means every
# tenant can read every other tenant's data, silently. See DEPLOYMENT.md Step 2.
DATABASE_URL=postgresql://app_user:STRONG_PASSWORD@localhost:5432/qalisuite

# Migrations, tenant provisioning, and the SuperAdmin platform dashboard —
# the reads that are legitimately cross-company. Never ordinary request traffic.
DIRECT_DATABASE_URL=postgresql://postgres@localhost:5432/qalisuite

# Postgres connections per Node process.
# Keep (PGPOOL_MAX x PM2 instances) comfortably below max_connections.
PGPOOL_MAX=10

# NOT SET IN PRODUCTION. It disables the guard that blocks unscoped,
# RLS-bypassing database access. Maintenance scripts only.
# ALLOW_UNSCOPED_DB=

# ── Cron ────────────────────────────────────────────────────────────────────
# REQUIRED. All five /api/cron/* routes 401 without a matching bearer token,
# which looks exactly like a job that ran and did nothing.
CRON_SECRET=          # openssl rand -hex 32

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=QaliSuite <noreply@yourdomain.com>

# ── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (file uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── URLs — must match the TLS certificate ───────────────────────────────────
APP_URL=https://qalisuite.com
NEXTAUTH_URL=https://qalisuite.com
AUTH_URL=https://qalisuite.com
